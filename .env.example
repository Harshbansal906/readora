# ==========================================
# READORA Platform - Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=readora_super_secret_jwt_key_2026

# Database Path (SQLite)
DB_PATH=./readora.db

# Email OTP Verification (Gmail SMTP / Nodemailer)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_16_character_app_password
FROM_EMAIL="READORA Team" <your_email@gmail.com>

# Google Gemini AI (get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
