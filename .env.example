# =========================================================================
# READORA Platform — Production Environment Variables Reference
# =========================================================================

# -------------------------------------------------------------------------
# 1. Server Configuration
# -------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# -------------------------------------------------------------------------
# 2. JWT Authentication Secret
# (Generate a strong random string in production, e.g. via `openssl rand -hex 32`)
# -------------------------------------------------------------------------
JWT_SECRET=readora_super_secret_jwt_key_2026_creator_sanctuary

# -------------------------------------------------------------------------
# 3. Database Connection
# -------------------------------------------------------------------------
# For Local Development (SQLite):
DB_PATH=./readora.db

# For Production (PostgreSQL on Render / Supabase):
# Automatically provided on Render via Blueprint, or paste your PostgreSQL connection string:
# DATABASE_URL=postgresql://readora:password@dpg-xxxxx.oregon-postgres.render.com/readora

# -------------------------------------------------------------------------
# 4. Cloudinary Permanent Media Storage
# Get your free cloud credentials at: https://cloudinary.com/console
# -------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------------------------------------
# 5. Production Email (OTP & Password Reset)
# -------------------------------------------------------------------------
# OPTION A: Resend HTTP REST API (Recommended for Cloud — 100% Free, bypasses SMTP blocks)
# Get a free API key at: https://resend.com
RESEND_API_KEY=re_123456789
FROM_EMAIL=READORA <onboarding@resend.dev>

# OPTION B: Gmail SMTP Fallback (Nodemailer)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_16_character_app_password
# FROM_EMAIL="READORA Team" <your_email@gmail.com>

# -------------------------------------------------------------------------
# 6. Google Gemini AI Integration (Optional)
# Get your free API key at: https://aistudio.google.com/app/apikey
# -------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
